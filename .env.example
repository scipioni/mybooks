# --- Admin bootstrap ---------------------------------------------------
# The Google account with this exact email is auto-provisioned as the
# first admin user on its first successful sign-in. Required.
ADMIN_EMAIL=you@example.com

# --- Google OAuth (NextAuth) ---------------------------------------------
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth core --------------------------------------------------------
# Random secret used to sign/encrypt session JWTs. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# Public base URL of the deployment, e.g. https://mybooks.example.com
NEXTAUTH_URL=http://localhost:3012

# --- SMTP (e-reader delivery) ---------------------------------------------
# Used by nodemailer to email EPUB attachments to registered device
# addresses (e.g. a Kindle "send to Kindle" email address).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=mybooks@example.com

# --- Open Library metadata (optional) --------------------------------------
# Nothing to configure to use Open Library itself. Setting ADMIN_EMAIL above
# already raises its rate limit via an identifying User-Agent header.

# --- Google Books fallback (optional) ---------------------------------------
# Used only when an Open Library search/ISBN lookup finds nothing (e.g. an
# edition Open Library hasn't catalogued, such as many translated titles).
# Works without a key at a small anonymous daily quota; a free Google Cloud
# API key (enable the "Books API") raises that quota substantially.
GOOGLE_BOOKS_API_KEY=

# --- Storage ---------------------------------------------------------------
# Where uploaded EPUB files + extracted covers are stored, laid out as
# <BOOKS_STORAGE_PATH>/<user_id>/<book_id>.epub. In Docker this should be a
# path inside a mounted volume (see docker-compose.yml), e.g. /data/books.
BOOKS_STORAGE_PATH=./data/books

# Path to the SQLite database file. In Docker this should be a path inside
# a mounted volume (see docker-compose.yml), e.g. /data/db/mybooks.db.
DATABASE_PATH=./data/db/mybooks.db
